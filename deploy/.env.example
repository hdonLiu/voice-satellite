# Public DNS name pointing to the VPS. Do not include https://.
VS_DOMAIN=voice.example.com
ACME_EMAIL=admin@example.com

# Optional IP-certificate deployment. These are used only with
# deploy/compose.ip.yaml and a certificate already present on the host.
# VS_PUBLIC_HOST=203.0.113.10
# VS_LETSENCRYPT_DIR=/etc/letsencrypt

# Current milestone: validate authenticated ESP32 WSS and audio upload only.
VS_RELAY_MODE=device-link

# Relay process and device credential.
VS_RELAY_HOST=0.0.0.0
VS_RELAY_PORT=8787
VS_RELAY_DEVICE_TOKENS={"link-probe":"replace-device-token"}

# Conversation mode is enabled later with VS_RELAY_MODE=conversation.
# It additionally requires the following Connector and speech settings.
# VS_CONNECTOR_ID=openclaw-primary
# VS_RELAY_CONNECTOR_TOKEN=replace-connector-token
# OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TRANSCRIBE_LANGUAGE=zh
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
