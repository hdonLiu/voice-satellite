# Public DNS name pointing to the VPS. Do not include https://.
VS_DOMAIN=voice.example.com
ACME_EMAIL=admin@example.com

# Speech provider. OPENAI_BASE_URL may point to another compatible provider.
OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_LANGUAGE=zh
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Relay process and separately scoped credentials.
VS_RELAY_HOST=0.0.0.0
VS_RELAY_PORT=8787
VS_RELAY_DEVICE_TOKENS={"link-probe":"replace-device-token"}
VS_CONNECTOR_ID=openclaw-primary
VS_RELAY_CONNECTOR_TOKEN=replace-connector-token
