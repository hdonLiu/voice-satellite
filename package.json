{
  "name": "voice-satellite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "pretest": "pnpm --filter @voice-satellite/contracts build",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:check": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#**/node_modules/**\" \"#**/dist/**\"",
    "check": "pnpm format:check && pnpm docs:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/ws": "8.18.1",
    "markdownlint-cli2": "0.18.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
