# Relay process
OPENAI_API_KEY=replace-me
VS_RELAY_HOST=0.0.0.0
VS_RELAY_PORT=8787
VS_RELAY_DEVICE_TOKENS={"esp32-living-room":"replace-device-token"}
VS_CONNECTOR_ID=openclaw-primary
VS_RELAY_CONNECTOR_TOKEN=replace-connector-token

# Connector process (normally on another computer)
VS_RELAY_URL=wss://relay.example.com/v1/connector
VS_CONNECTOR_STATE_FILE=/absolute/path/to/sessions.json
OPENCLAW_EXECUTABLE=openclaw
OPENCLAW_ACP_ARGS=acp
OPENCLAW_WORKDIR=/absolute/path/authorized-for-openclaw
